# ── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-forte-e-aleatoria-minimo-32-chars

# ── Supabase PostgreSQL ────────────────────────────────────
# Copie do painel Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[SEU-REF].supabase.co:5432/postgres

# ── Vercel Blob Storage ────────────────────────────────────
# 1. Acesse vercel.com → seu projeto → Storage → Create Blob Store
# 2. Copie o token gerado abaixo:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ── CORS ──────────────────────────────────────────────────
# URL do seu frontend no Vercel (sem barra no final)
FRONTEND_URL=https://garagemdofrango.vercel.app
